# Build-time public navigation origin. No API keys or authentication tokens.
NEXT_PUBLIC_PANEL_URL=https://panel.mlkino.com
# For local development, set this in .env.local:
# NEXT_PUBLIC_PANEL_URL=http://localhost:3000

# Same API used by panel; session cookies stay HttpOnly on the API domain.
NEXT_PUBLIC_API_URL=https://api.mlkino.com
# Local: NEXT_PUBLIC_API_URL=http://localhost:8000
