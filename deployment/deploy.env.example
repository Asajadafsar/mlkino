# Server paths observed via read-only SSH on 2026-10-31. No credentials.
BACKEND_DIR=/var/www/mlkino
BACKEND_PYTHON=/var/www/mlkino/venv/bin/python
FRONTEND_DIR=/var/www/mlkino-frontend
BACKUP_ROOT=/var/backups/mlkino
GUNICORN_SERVICES='gunicorn.service django-app.service'
ASGI_SERVICE=mlkino-asgi.service
REDIS_SERVICE=redis-server.service
API_NGINX_FILE=/etc/nginx/sites-available/api.mlkino.com
PANEL_NGINX_FILE=/etc/nginx/sites-available/panel.mlkino.com
# Must be set to YES only for a specific deployment approved by the owner.
MLKINO_APPROVED=NO
MLKINO_MIGRATIONS_APPROVED=NO
# Both Gunicorn services currently bind the same socket. Resolution requires review.
MLKINO_DUAL_GUNICORN_REVIEWED=NO
# Proposed resolution, inactive until the owner approves it:
MLKINO_DUPLICATE_ACTION=UNREVIEWED
# Approved value: stop-disable-django-app
