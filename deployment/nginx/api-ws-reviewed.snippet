# Review within /etc/nginx/sites-available/api.mlkino.com; /ws/ already exists.
# Nginx must forward BOTH /ws/chats/<id>/ AND /ws/inbox/ unchanged.
location /ws/ {
    proxy_pass http://127.0.0.1:8001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
# Place before the existing location /media/: private uploads require authenticated APIs.
location ^~ /media/private_chat/ { return 404; }
location ^~ /media/private_tickets/ { return 404; }
